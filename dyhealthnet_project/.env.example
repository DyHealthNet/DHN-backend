SECRET_KEY= #Add secret key!
# This needs to correspond to the url you are accessing the site with
FRONTEND_HOME_URL=http://127.0.0.1:5173

DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASS=password
DB_HOST=0.0.0.0
DB_PORT=9852

#Add paths to your data! Each data source (e.g. phenotypes, proteins, metabolites, genomic
#variants) is described by its own meta data file, label column and type column.
# Data sources, mirroring DHN-database's setup_db_new.py: provide comma-separated lists of
# equal length, one entry per data source. DATA_ROOT, if set, is prepended to any relative
# entry in DATA_PATHS/DATA_META_PATHS, so you only need to provide file names there.
DATA_ROOT=
DATA_PATHS=/path/to/phenotypes.csv
DATA_META_PATHS=/path/to/pheno_meta.csv
DATA_LABEL_COLUMNS=label
#Specify the type column or simply the type of each data source
DATA_TYPE_COLUMNS=type
#Optional: description column (or a literal description) per data source, used for display
DATA_DESCRIPTION_COLUMNS=
#Optional: group column (or a literal group name) per data source. Set this to
#phenotype/protein/metabolite for the corresponding sources to keep the
#variable-overview endpoints and the context feature working as before.
DATA_GROUP_COLUMNS=phenotype,protein,metabolite

# Other options
#Optional: Here you can add a JSON file that maps your categorical variables encoded by integers to the actual categories.
VAR_LABEL_MAPPING=None
#Adjust the path where to save the calculated association scores for your data!
CALCULATED_EDGES_PATH=./association_scores.csv
#Number of Contexts a User is allowed to create and least number of patients required to create a context
MAX_CONTEXT_PER_USER=5
#For privay protection, if less this amount of people are in a group for visualization on the data overview page
#no data will be shown or send to the frontend
CRITICAL_NUMBER=5

# Score calculation settings
#Patient/ Participent index column of your data tables. Adjust accordingly!
PATIENT_ID_COLUMN=Patient ID
#Adjust according to your preferences!
NUMBER_OF_WORKERS=16
TEST_TYPE=all
NAN_VALUE=-89
MULTIPLE_TESTING=bh
#Name of the cohort/observation source - used to name the saved association score files
OBSERVATION_SOURCE=CHRIS

