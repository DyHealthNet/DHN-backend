# Copy to digest_django.env and fill in real secrets before running:
#   docker compose -f docker-compose.digest.yml up -d
# Mirrors bionetslab/digest-api's own docker-django-example.env.dev.
DEBUG=0
SECRET_KEY=changeme
SUPERUSER_NAME=admin
SUPERUSER_PASS=changeme
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=digest
SQL_USER=digester
SQL_PASSWORD=changeme
SQL_HOST=digest_db
SQL_PORT=5432
POSTGRES_DB=digest
POSTGRES_USER=digester
POSTGRES_PASSWORD=changeme
REDIS_HOST=digest_redis
REDIS_PORT=6379
INTERNAL_KEY=changeme
DJANGO_SETTINGS_MODULE=digest_backend.settings
CELERY_BROKER_URL=redis://digest_redis:6379/0
